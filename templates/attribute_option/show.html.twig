{% extends 'base.html.twig' %}

{% block title %}AttributeOption{% endblock %}

{% block body %}
    <h1>AttributeOption</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ attribute_option.id }}</td>
            </tr>
            <tr>
                <th>Value</th>
                <td>{{ attribute_option.value }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ attribute_option.label }}</td>
            </tr>
            <tr>
                <th>SortOrder</th>
                <td>{{ attribute_option.sortOrder }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_attribute_option_index') }}">back to list</a>

    <a href="{{ path('app_attribute_option_edit', {'id': attribute_option.id}) }}">edit</a>

    {{ include('attribute_option/_delete_form.html.twig') }}
{% endblock %}
