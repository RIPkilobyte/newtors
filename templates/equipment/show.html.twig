{% extends 'base.html.twig' %}

{% block title %}Equipment{% endblock %}

{% block body %}
    <h1>Equipment</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ equipment.id }}</td>
            </tr>
            <tr>
                <th>Inventory</th>
                <td>{{ equipment.inventory }}</td>
            </tr>
            <tr>
                <th>Serial</th>
                <td>{{ equipment.serial }}</td>
            </tr>
            <tr>
                <th>Attributes</th>
                <td>
                    <ul>
                    {% for key, value in equipment.attributes %}
                        <li><strong>{{ key }}:</strong>
                            {% if value is iterable %}
                                {{ value|join(', ') }}
                            {% else %}
                                {{ value }}
                            {% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('equipment_index') }}">back to list</a>

    <a href="{{ path('equipment_edit', {'id': equipment.id}) }}">edit</a>

    {{ include('equipment/_delete_form.html.twig') }}
{% endblock %}
