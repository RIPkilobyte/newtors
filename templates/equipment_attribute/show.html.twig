{% extends 'base.html.twig' %}

{% block title %}EquipmentAttribute{% endblock %}

{% block body %}
    <h1>EquipmentAttribute</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ equipment_attribute.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ equipment_attribute.name }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ equipment_attribute.label }}</td>
            </tr>
            <tr>
                <th>DataType</th>
                <td>{{ equipment_attribute.dataType }}</td>
            </tr>
            <tr>
                <th>IsMultiple</th>
                <td>{{ equipment_attribute.isMultiple ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('equipment_attribute_index') }}">back to list</a>

    <a href="{{ path('equipment_attribute_edit', {'id': equipment_attribute.id}) }}">edit</a>

    {{ include('equipment_attribute/_delete_form.html.twig') }}
{% endblock %}
