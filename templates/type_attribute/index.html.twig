{% extends 'base.html.twig' %}

{% block title %}TypeAttribute index{% endblock %}

{% block body %}
    <h1>TypeAttribute index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Required</th>
                <th>SortOrder</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for type_attribute in type_attributes %}
            <tr>
                <td>{{ type_attribute.id }}</td>
                <td>{{ type_attribute.required ? 'Yes' : 'No' }}</td>
                <td>{{ type_attribute.sortOrder }}</td>
                <td>
                    <a href="{{ path('app_type_attribute_show', {'id': type_attribute.id}) }}">show</a>
                    <a href="{{ path('app_type_attribute_edit', {'id': type_attribute.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_type_attribute_new') }}">Create new</a>
{% endblock %}
