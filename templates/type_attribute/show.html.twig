{% extends 'base.html.twig' %}

{% block title %}TypeAttribute{% endblock %}

{% block body %}
    <h1>TypeAttribute</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ type_attribute.id }}</td>
            </tr>
            <tr>
                <th>Required</th>
                <td>{{ type_attribute.required ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>SortOrder</th>
                <td>{{ type_attribute.sortOrder }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_type_attribute_index') }}">back to list</a>

    <a href="{{ path('app_type_attribute_edit', {'id': type_attribute.id}) }}">edit</a>

    {{ include('type_attribute/_delete_form.html.twig') }}
{% endblock %}
